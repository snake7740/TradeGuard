# TradeGuard 本地演示环境配置（复制为 .env 后按需修改）
# 生产/复赛环境：凭据一律经 Higress 透传，不落本文件（04 §5）

# PostgreSQL（PolarDB-PG 本地等价）
PG_SUPER_PASSWORD=tradeguard_dev
PG_DSN_WEB=postgresql://tg_web:tg_web_dev@postgres:5432/tradeguard
PG_DSN_APP=postgresql://tg_app:tg_app_dev@postgres:5432/tradeguard

# RocketMQ
ROCKETMQ_VERSION=5.3.1

# LLM（经 Higress 凭据透传；此处仅供本地直连调试，勿提交真实 Key）
DASHSCOPE_API_KEY=
