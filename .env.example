# TradeGuard 本地环境配置模板（复制为 .env 后按需修改；.env 已被 .gitignore 排除，绝不提交）
# 克隆后最小启动路径：cp .env.example .env → scripts/start_all.py（CHANGE_ME 会被自动换成随机强值）
# 生产环境：凭据一律经 Higress 透传，不落本文件（04 §5）

# ---- PostgreSQL（PolarDB-PG 本地等价；仅回环发布 127.0.0.1:5433） ----
# 本地开发缺省口令仅对回环可见；新部署建议改强口令（需同步 ALTER ROLE 或 down -v 重建卷）
PG_SUPER_PASSWORD=tradeguard_dev
PG_DSN_WEB=postgresql://tg_web:tg_web_dev@postgres:5432/tradeguard
PG_DSN_APP=postgresql://tg_app:tg_app_dev@postgres:5432/tradeguard

# ---- RocketMQ ----
ROCKETMQ_VERSION=5.3.1

# ---- LLM（经 Higress 凭据透传；此处仅供本地直连调试，勿提交真实 Key；
#      真实 Key 一律放 secrets/dashscope.env，格式见 secrets/dashscope.env.example） ----
DASHSCOPE_API_KEY=

# ---- web-api bearer 守卫（US-E7-01）：/api/** 强制 Bearer；
#      门户 nginx 反代自动注入，浏览器/脚本无需感知。CHANGE_ME=start_all 自动生成随机值 ----
TG_API_TOKEN=CHANGE_ME

# ---- Nacos v3 鉴权（镜像强制要求；serverIdentity 互信头 + JWT 密钥）
#      CHANGE_ME=start_all 自动生成随机值。一旦修改需 compose 重建 nacos 容器生效 ----
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME
NACOS_AUTH_TOKEN=CHANGE_ME
