# TradeGuard LLM 凭据模板（复制为 secrets/dashscope.env 后填入真实值）
# secrets/ 目录已被 .gitignore 排除（仅 *.example 模板入库），真实文件绝不提交。
# 消费方：scripts/set-dashscope-key.ps1（AgentTeams 注入）、scripts/friday_run.sh（Friday 直跑取证）、
#         scripts/update-agentteams-llm.sh。格式为 sh 可 source 的 KEY=VALUE 行。

# 必填：DashScope / 通义 API Key（从租户控制台获取）
DASHSCOPE_API_KEY=sk-your-api-key-here

# 租户 MaaS OpenAI 兼容端点（base_url）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENTTEAMS_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# AgentTeams 非交互安装与模型选择
AGENTTEAMS_NON_INTERACTIVE=1
AGENTTEAMS_LLM_PROVIDER=openai
AGENTTEAMS_DEFAULT_MODEL=qwen3.8-max
AGENTTEAMS_REGISTRY=dashscope
